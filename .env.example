# =====================================================================
# Скопируй в .env и заполни. Никогда не коммить .env в git.
# =====================================================================

# --- Telegram ---
# Получить у @BotFather: /newbot
TELEGRAM_BOT_TOKEN=

# Список chat_id, в которых бот должен реагировать. Через запятую.
# Узнать chat_id: добавить бота в группу, написать /chatid — бот ответит.
# В группах id отрицательный (например, -1001234567890).
ALLOWED_CHAT_IDS=

# --- Подмена ---
# Список хостов-зеркал через запятую, в порядке приоритета.
# Первый идёт основной ссылкой (с превью), остальные — как резервные.
# Если какое-то зеркало стабильно лежит — поменяй порядок или убери из списка.
# Известные зеркала: www.kkclip.com, www.eeinstagram.com, www.ddinstagram.com,
# www.kkinstagram.com, g.ddinstagram.com.
TARGET_HOSTS=www.kkclip.com,www.eeinstagram.com,www.ddinstagram.com

# --- Логирование ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (читаемый) или json (для прод-сервера)
LOG_FORMAT=console
